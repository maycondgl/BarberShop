@inherits LayoutComponentBase

<MudThemeProvider Theme="Configuration.Theme" IsDarkMode="true" />
<MudSnackbarProvider />
<MudDialogProvider />

<AuthorizeView>
    <Authorized Context="userContext">
        <MudLayout Class="app-layout app-shell--dark">
            <!-- Barra Superior (AppBar) -->
            <MudAppBar Elevation="2" Dense="false" Class="app-mud-appbar">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="@ToggleDrawer"
                               Size="Size.Large"
                               Class="mr-2"
                               Title="Alternar menu de navegação" />

                <a href="/" class="d-flex align-center gap-3 text-decoration-none" style="color: inherit;">
                    <img src="Imgs/logo23-transparent.png" alt="Essência da Beleza" style="height: 42px; width: auto;" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold d-none d-sm-flex" Style="letter-spacing: .5px;">
                        Essência da Beleza
                    </MudText>
                </a>

                <MudSpacer />

                <AuthorizeView Roles="Admin">
                    <Authorized Context="adminContext">
                        <AdminNotificationListener />
                    </Authorized>
                </AuthorizeView>

            </MudAppBar>

            <!-- Menu Lateral (Drawer) -->
            <MudDrawer @bind-Open="_drawerOpen"
                       ClipMode="DrawerClipMode.Always"
                       Elevation="3"
                       Width="300px"
                       Variant="DrawerVariant.Responsive"
                       Class="app-mud-drawer">
                <MudDrawerHeader Class="d-flex align-center gap-3 px-4 py-3">
                    <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.ContentCut" Size="Size.Medium" />
                    </MudAvatar>
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="line-height: 1.2;">
                            Essência da Beleza
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Barbearia & Estilo
                        </MudText>
                    </div>
                </MudDrawerHeader>

                <NavMenu />
            </MudDrawer>

            <!-- Conteúdo Principal -->
            <MudMainContent Class="app-mud-main">
                <main class="app-content px-3 px-sm-6">
                    @Body
                </main>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
