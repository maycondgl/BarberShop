@page "/agendamentos/adicionar"
@inherits CreateAgendamentoPage

<MudText Typo="Typo.h3">Novo Agendamento</MudText>

<MudPaper Class="pa-8 mt-4">
    @if (IsLoading)
    {
        <div class="d-flex justify-center mt-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
            <DataAnnotationsValidator />

            <MudSelect T="long"
                       Label="Tipo de Corte"
                       HelperText="Campo obrigatório"
                       @bind-Value="InputModel.CorteId"
                       Class="mt-4"
                       Required="true">
                @foreach (var corte in Cortes)
                {
                    <MudSelectItem T="long" Value="@corte.Id">@corte.Titulo</MudSelectItem>
                }
            </MudSelect>

            <!-- SOLUÇÃO: Não utilizamos o EventCallback manual, e simplificamos a função de bloqueio -->
            <MudDatePicker Label="Data do Agendamento"
                           Date="InputModel.Data"
                           DateChanged="OnDateChangedAsync"
                           IsDateDisabledFunc="IsDateDisabled"
                           Required="true"
                           Class="mt-4" />

            <MudText Typo="Typo.subtitle2" Class="mt-6 mb-2">Horários Disponíveis:</MudText>
            
            @if (IsBusy)
            {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
            }
            else
            {
                @if (HorariosDisponiveis.Any())
                {
                    <MudChipSet @bind-SelectedValue="HorarioSelecionado" Filter="true" Mandatory="true">
                        @foreach (var hora in HorariosDisponiveis)
                        {
                            <MudChip Text="@hora.ToString(@"hh\:mm")" 
                                     Value="@hora" 
                                     Color="Color.Primary" 
                                     Variant="Variant.Outlined" />
                        }
                    </MudChipSet>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-2">
                        Não há horários disponíveis para este dia. Escolha outra data.
                    </MudAlert>
                }
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Event"
                       Class="action-btn mt-6"
                       Disabled="@IsBusy">
                @(IsBusy ? "Aguarde..." : "Agendar")
            </MudButton>

        </EditForm>
    }
</MudPaper>