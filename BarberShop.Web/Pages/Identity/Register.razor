@page "/comecar"
@layout HeadlessLayout
@inherits RegisterPage

<PageTitle>BarberShop - Criar conta</PageTitle>

<main class="auth-page">
    <section class="auth-shell auth-shell--register" aria-label="Cadastro">
        <aside class="auth-panel auth-panel--accent">
            <div>
                <span class="auth-kicker">Bem-vindo</span>
                <h2>Já tem uma conta?</h2>
                <p>Entre para acessar seus agendamentos e continuar cuidando do seu estilo.</p>
            </div>

            <a class="auth-outline-button" href="/entrar">Fazer login</a>
        </aside>

        <div class="auth-panel auth-panel--form">
            <img class="auth-logo" src="Imgs/logo23-transparent.png" alt="Essencia da Beleza" />

            <div class="auth-heading">
                <h1>Criar conta</h1>
                <p>Preencha seus dados para começar a agendar.</p>
            </div>

            <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync" class="auth-form">
                <DataAnnotationsValidator />

                <MudTextField T="string"
                              Label="Nome completo"
                              For="@(() => InputModel.Nome)"
                              @bind-Value="InputModel.Nome"
                              Required="true"
                              RequiredError="Nome inválido"
                              Variant="Variant.Filled"
                              Margin="Margin.Dense"
                              Class="auth-field" />

                <MudTextField T="string"
                              Label="Número"
                              For="@(() => InputModel.Telefone)"
                              @bind-Value="InputModel.Telefone"
                              Mask="@PhoneMask"
                              InputType="InputType.Telephone"
                              Required="true"
                              RequiredError="Informe o telefone"
                              Variant="Variant.Filled"
                              Margin="Margin.Dense"
                              Class="auth-field" />

                <MudTextField T="string"
                              Label="E-mail"
                              For="@(() => InputModel.Email)"
                              @bind-Value="InputModel.Email"
                              InputType="InputType.Email"
                              Required="true"
                              RequiredError="Informe o e-mail"
                              Variant="Variant.Filled"
                              Margin="Margin.Dense"
                              Class="auth-field" />

                <MudTextField T="string"
                              Label="Senha"
                              For="@(() => InputModel.Senha)"
                              @bind-Value="InputModel.Senha"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                              AdornmentAriaLabel="Alternar visualização da senha"
                              Required="true"
                              RequiredError="Informe a senha"
                              Variant="Variant.Filled"
                              Margin="Margin.Dense"
                              Class="auth-field" />

                <MudTextField T="string"
                              Label="Confirmar senha"
                              For="@(() => InputModel.ConfirmarSenha)"
                              @bind-Value="InputModel.ConfirmarSenha"
                              InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => _showConfirmPassword = !_showConfirmPassword)"
                              AdornmentAriaLabel="Alternar visualização da confirmação de senha"
                              Required="true"
                              RequiredError="Confirme sua senha"
                              Variant="Variant.Filled"
                              Margin="Margin.Dense"
                              Class="auth-field" />

                <MudTextField T="string"
                              Label="Chave de administrador"
                              For="@(() => InputModel.ChaveAdmin)"
                              @bind-Value="InputModel.ChaveAdmin"
                              InputType="InputType.Password"
                              Variant="Variant.Filled"
                              Margin="Margin.Dense"
                              Class="auth-field" />

                @if (IsBusy)
                {
                    <MudProgressCircular Color="Color.Warning" Indeterminate="true" />
                }
                else
                {
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Warning"
                               Class="auth-submit">
                        Começar
                    </MudButton>
                }
            </EditForm>
        </div>
    </section>

    @if (ShowWelcomeModal)
    {
        <div class="welcome-modal-backdrop" @onclick="CloseWelcomeModal">
            <div class="welcome-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="welcome-modal-title">
                <button type="button" class="welcome-modal__close" @onclick="CloseWelcomeModal" aria-label="Fechar mensagem de boas-vindas">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>

                <div class="confetti-container" aria-hidden="true">
                    @for (int i = 0; i < 32; i++)
                    {
                        <span class="confetti-piece confetti-piece--@i"></span>
                    }
                </div>

                <div class="welcome-modal__badge">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Class="welcome-modal__badge-icon" />
                    <span>Cadastro concluído!</span>
                </div>

                <h2 id="welcome-modal-title" class="welcome-modal__title">
                    Seja bem-vindo à sua barbearia de melhor gerenciamento de agendamentos
                </h2>

                <p class="welcome-modal__desc">
                    Sua conta foi criada com sucesso! Agora você tem facilidade para agendar horários, escolher serviços de qualidade e acompanhar seu visual.
                </p>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           Class="welcome-modal__button"
                           OnClick="CloseWelcomeModal">
                    Ir para o login
                </MudButton>
            </div>
        </div>
    }
</main>
