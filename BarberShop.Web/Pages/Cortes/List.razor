@page "/cortes"
@inherits ListCortesPage

<PageTitle>Serviços</PageTitle>

<div class="cuts-page">
    <MudPaper Elevation="0"
              Class="cuts-hero-panel mb-6">
        <div class="cuts-hero-layout">
            <div>
                <MudText Typo="Typo.overline" Style="color: #ffc107; letter-spacing: .18em; font-weight: 800;">
                    Catálogo de serviços
                </MudText>
                <MudText Typo="Typo.h2" Style="font-weight: 800; line-height: 1; margin-top: 8px;">
                    Serviços
                </MudText>
                <MudText Typo="Typo.h5" Style="color: #ffc107; font-weight: 700; margin-top: 10px;">
                    Escolha seu estilo
                </MudText>
                <MudText Typo="Typo.body1" Style="max-width: 660px; color: rgba(255,255,255,.72); margin-top: 8px;">
                    Veja referências de serviços, compare valores e escolha o visual ideal antes de agendar.
                </MudText>
            </div>
            <div class="cuts-hero-count">
                <MudIcon Icon="@Icons.Material.Filled.ContentCut" Size="Size.Large" />
                <MudText Typo="Typo.subtitle1" Style="font-weight: 800;">@Catalogo.Count estilos disponíveis</MudText>
                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,.62);">Catálogo visual</MudText>
            </div>
        </div>
    </MudPaper>

    @if (IsBusy)
    {
        <MudGrid Spacing="4">
            @for (var i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudSkeleton Height="380px" Style="border-radius: 32px;" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (!Cortes.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mt-6">
            Nenhum serviço encontrado. Cadastre os serviços para montar o catálogo.
        </MudAlert>
    }
    else
    {
        <div style="padding: 0 16px;">
            <div class="cc-grid">
                @foreach (var corte in Catalogo)
                {
                    <div class="@GetCardClass(corte.Id)"
                         @onclick="() => SelectImage(corte.Id)">

                        <div class="cc-card__glow"></div>

                        <div class="cc-card__img-wrap">
                            <img src="@corte.ImagemUrl" alt="@corte.Titulo" />
                        </div>

                        <div class="cc-card__body">
                            <span class="cc-card__eyebrow">Corte</span>
                            <h3 class="cc-card__title">@corte.Titulo</h3>
                            <p class="cc-card__desc">
                                @corte.Descricao
                            </p>
                            <div class="cc-chips">
                                <span class="cc-chip cc-chip--time">@FormatDuration(corte.DuracaoMinutos)</span>
                                <span class="cc-chip cc-chip--price">@FormatPrice(corte.Preco)</span>
                            </div>
                            <button class="cc-card__btn"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ScheduleCut(corte.Id)">
                                ✂ Agendar
                            </button>
                        </div>

                    </div>
                }
            </div>  
        </div> 

        <MudPaper Elevation="0"
                  Class="pa-6 mt-6"
                  Style="border-radius: 30px; border: 1px solid rgba(255,255,255,.08); background: #1d1d1f; box-shadow: 0 22px 54px rgba(0,0,0,.24);">
            <MudText Typo="Typo.overline" Style="color: #ffc107; letter-spacing: .18em; font-weight: 800;">
                Valores
            </MudText>
            <MudText Typo="Typo.h4" Style="font-weight: 800; margin-bottom: 18px;">Tabela de Preços</MudText>

            <!-- Visualização Desktop (Tabela Polida) -->
            <div class="d-none d-md-block">
                <MudTable Items="@Catalogo" Hover="true" Style="overflow: hidden; border-radius: 20px; background: #181819;">
                    <HeaderContent>
                        <MudTh>Serviço</MudTh>
                        <MudTh>Duração</MudTh>
                        <MudTh>Valor</MudTh>
                        <MudTh Style="text-align: right;"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Serviço"><strong>@context.Titulo</strong></MudTd>
                        <MudTd DataLabel="Duração">@FormatDuration(context.DuracaoMinutos)</MudTd>
                        <MudTd DataLabel="Valor"><span style="color: #ffc107; font-weight: 700;">@FormatPrice(context.Preco)</span></MudTd>
                        <MudTd Style="text-align: right;">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Event"
                                       OnClick="@(() => ScheduleCut(context.Id))">
                                Agendar
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>

            <!-- Visualização Mobile (Cards Separados por Serviço) -->
            <div class="d-block d-md-none">
                <div class="price-cards-list">
                    @foreach (var item in Catalogo)
                    {
                        <div class="price-service-card">
                            <div class="price-service-card__header">
                                <h4 class="price-service-card__title">@item.Titulo</h4>
                                <span class="price-service-card__badge">@FormatPrice(item.Preco)</span>
                            </div>
                            <div class="price-service-card__footer">
                                <span class="price-service-card__time">
                                    <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                                    @FormatDuration(item.DuracaoMinutos)
                                </span>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Event"
                                           OnClick="@(() => ScheduleCut(item.Id))">
                                    Agendar
                                </MudButton>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </MudPaper>
    }
</div>
