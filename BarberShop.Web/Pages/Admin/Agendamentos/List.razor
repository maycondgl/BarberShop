@page "/admin/agendamentos"
@using BarberShop.Core.Responses.Agendamento
@inherits ListAdminAgendamentoPage
@using System.Globalization

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-2">
            <div>
                <MudText Typo="Typo.h3">Gerenciar Agendamentos</MudText>
                <MudText Typo="Typo.body1" Style="opacity:.7;">
                    Visualize, aceite e conclua os agendamentos dos clientes com controle temporal completo.
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="IsBusy"
                       OnClick="LoadAdminAgendamentosAsync">
                @(IsBusy ? "Atualizando..." : "Atualizar")
            </MudButton>
        </div>

        <!-- CARDS DE ESTATÍSTICAS DO PERÍODO -->
        <MudGrid Class="admin-stats-grid mb-6" Spacing="2">
            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="admin-stat-card">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth"
                             Class="admin-stat-icon"
                             Color="Color.Warning"
                             Size="Size.Large" />
                    <MudText Class="admin-stat-title">Agendamentos (@FiltroPeriodo)</MudText>
                    <MudText Class="admin-stat-value">@TotalPeriodo</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="admin-stat-card">
                    <MudIcon Icon="@Icons.Material.Filled.PendingActions"
                             Class="admin-stat-icon"
                             Color="Color.Warning"
                             Size="Size.Large" />
                    <MudText Class="admin-stat-title">Pendentes</MudText>
                    <MudText Class="admin-stat-value">@TotalPendentes</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="admin-stat-card">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline"
                             Class="admin-stat-icon"
                             Color="Color.Success"
                             Size="Size.Large" />
                    <MudText Class="admin-stat-title">Concluídos</MudText>
                    <MudText Class="admin-stat-value" Style="color: #4CAF50;">@TotalConcluidos</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="admin-stat-card">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet"
                             Class="admin-stat-icon"
                             Color="Color.Info"
                             Size="Size.Large" />
                    <MudText Class="admin-stat-title">Faturamento (@FiltroPeriodo)</MudText>
                    <MudText Class="admin-stat-value" Style="color: #2196F3; font-size: 1.3rem;">@FaturamentoPeriodo.ToString("C2", PtBr)</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Class="admin-grid" Spacing="3">
            <MudItem xs="12">
                <MudPaper Class="admin-panel admin-table-panel">
                    <!-- SELETOR DE PERÍODO & CONTROLES -->
                    <div class="pa-4 pb-0">
                        <div class="d-flex justify-space-between align-center flex-wrap gap-3 mb-3">
                            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small">
                                <MudButton Variant="@(FiltroPeriodo == "Dia" ? Variant.Filled : Variant.Outlined)"
                                           OnClick="@(() => SetPeriodo("Dia"))">
                                    Dia (@ObterContagemPeriodo("Dia"))
                                </MudButton>
                                <MudButton Variant="@(FiltroPeriodo == "Semana" ? Variant.Filled : Variant.Outlined)"
                                           OnClick="@(() => SetPeriodo("Semana"))">
                                    Semana (@ObterContagemPeriodo("Semana"))
                                </MudButton>
                                <MudButton Variant="@(FiltroPeriodo == "Mes" ? Variant.Filled : Variant.Outlined)"
                                           OnClick="@(() => SetPeriodo("Mes"))">
                                    Mês (@ObterContagemPeriodo("Mes"))
                                </MudButton>
                                <MudButton Variant="@(FiltroPeriodo == "Ano" ? Variant.Filled : Variant.Outlined)"
                                           OnClick="@(() => SetPeriodo("Ano"))">
                                    Ano (@ObterContagemPeriodo("Ano"))
                                </MudButton>
                                <MudButton Variant="@(FiltroPeriodo == "Todos" ? Variant.Filled : Variant.Outlined)"
                                           OnClick="@(() => SetPeriodo("Todos"))">
                                    Todos (@ObterContagemPeriodo("Todos"))
                                </MudButton>
                            </MudButtonGroup>

                            <div class="d-flex align-center gap-2 flex-grow-1 justify-end" style="max-width: 450px;">
                                <MudTextField @bind-Value="SearchTerm"
                                              Placeholder="Buscar cliente, barbeiro, corte..."
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              Immediate="true"
                                              IconSize="Size.Small"
                                              Class="admin-search-field"
                                              Margin="Margin.Dense"
                                              Variant="Variant.Outlined" />

                                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.FilterAlt"
                                                   Class="admin-filter-btn">
                                            @(string.IsNullOrWhiteSpace(StatusFilter) ? "Status: Todos" : $"Status: {StatusFilter}")
                                        </MudButton>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem OnClick="@(() => SetStatusFilter(string.Empty))">Todos</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => SetStatusFilter("Pendente"))">Pendentes</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => SetStatusFilter("Aceito"))">Aceitos</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => SetStatusFilter("Concluido"))">Concluídos</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => SetStatusFilter("Cancelado"))">Cancelados</MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            </div>
                        </div>

                        @if (FiltroPeriodo != "Todos")
                        {
                            <!-- NAVEGADOR TEMPORAL (< DATA >) -->
                            <div class="d-flex justify-space-between align-center flex-wrap gap-2 px-3 py-2 rounded mb-3"
                                 style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                                <div class="d-flex align-center gap-2">
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                                   Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Warning"
                                                   Title="Anterior"
                                                   OnClick="@(() => NavegarPeriodo(-1))" />

                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Color="Color.Warning" />
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                            @PeriodoFormatado
                                        </MudText>
                                    </div>

                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                                   Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Warning"
                                                   Title="Próximo"
                                                   OnClick="@(() => NavegarPeriodo(1))" />
                                </div>

                                @if (!IsPeriodoAtual)
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Size="Size.Small"
                                               Color="Color.Warning"
                                               StartIcon="@Icons.Material.Filled.Today"
                                               OnClick="IrParaHoje">
                                        Voltar para Hoje
                                    </MudButton>
                                }
                            </div>
                        }
                    </div>

                    @if (IsBusy && !TodosAgendamentos.Any())
                    {
                        <div class="d-flex justify-center align-center pa-8">
                            <MudProgressCircular Color="Color.Warning" Indeterminate="true" />
                        </div>
                    }
                    else if (!FilteredAgendamentos.Any())
                    {
                        <div class="pa-8 text-center" style="opacity: 0.7;">
                            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.body1">Nenhum agendamento encontrado para <strong>@PeriodoFormatado</strong>.</MudText>
                        </div>
                    }
                    else
                    {
                        <!-- Visualização Desktop (Tabela Completa) -->
                        <div class="d-none d-md-block">
                            <div class="admin-table-scroll">
                                <table class="admin-schedule-table">
                                    <thead>
                                        <tr>
                                            <th>Cliente</th>
                                            <th>Data e Horário</th>
                                            <th>Serviço</th>
                                            <th>Filial</th>
                                            <th>Barbeiro</th>
                                            <th>Valor</th>
                                            <th>Minutos</th>
                                            <th>Status</th>
                                            <th>Ações</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var agendamento in PagedAgendamentos)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="admin-client-cell">
                                                        <span class="admin-avatar">@GetInitials(agendamento.NomeCliente)</span>
                                                        <span>
                                                            <strong>@agendamento.NomeCliente</strong>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="admin-date-cell">
                                                        <span><MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" /> @agendamento.Data.ToString("dd/MM/yyyy")</span>
                                                        <span><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" /> @agendamento.Data.ToString("HH:mm")</span>
                                                    </div>
                                                </td>
                                                <td>@agendamento.CorteTitulo</td>
                                                <td>@(string.IsNullOrWhiteSpace(agendamento.FilialNome) ? "-" : agendamento.FilialNome)</td>
                                                <td>@(string.IsNullOrWhiteSpace(agendamento.BarbeiroNome) ? "-" : agendamento.BarbeiroNome)</td>
                                                <td>@agendamento.Valor.ToString("C2", PtBr)</td>
                                                <td>@agendamento.TempoMinutos min</td>
                                                <td>
                                                    <span class="@GetStatusClass(agendamento.Status)">@GetStatusText(agendamento.Status)</span>
                                                </td>
                                                <td>
                                                    <div class="admin-actions">
                                                        <MudButton Variant="Variant.Filled"
                                                                   Color="Color.Success"
                                                                   Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                                                   Class="action-btn"
                                                                   OnClick="@(() => OnAceitarClickedAsync(agendamento.Id))"
                                                                   Disabled="@(agendamento.Status != "Pendente")">
                                                            Aceitar
                                                        </MudButton>
                                                        <MudButton Variant="Variant.Filled"
                                                                   Color="Color.Primary"
                                                                   Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.DoneAll"
                                                                   Class="action-btn"
                                                                   OnClick="@(() => OnConcluirClickedAsync(agendamento.Id))"
                                                                   Disabled="@IsConcluido(agendamento.Status)">
                                                            Concluir
                                                        </MudButton>

                                                        <MudTooltip Text="Excluir agendamento">
                                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                           Color="Color.Error"
                                                                           Size="Size.Small"
                                                                           OnClick="@(() => OnDeleteClickedAsync(agendamento.Id))" />
                                                        </MudTooltip>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Visualização Mobile (Cards Individuais) -->
                        <div class="d-block d-md-none">
                            <div class="admin-mobile-list" aria-label="Lista de agendamentos">
                                @foreach (var agendamento in PagedAgendamentos)
                                {
                                    <article class="admin-mobile-card">
                                        <div class="admin-mobile-card__main">
                                            <span class="admin-avatar">@GetInitials(agendamento.NomeCliente)</span>
                                            <div class="admin-mobile-card__content">
                                                <strong>@agendamento.NomeCliente</strong>
                                                <span>Corte: @agendamento.CorteTitulo</span>
                                                @if (!string.IsNullOrWhiteSpace(agendamento.FilialNome))
                                                {
                                                    <span class="d-flex align-center gap-1">
                                                        <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" />
                                                        @agendamento.FilialNome
                                                    </span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(agendamento.BarbeiroNome))
                                                {
                                                    <span class="d-flex align-center gap-1">
                                                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                                        @agendamento.BarbeiroNome
                                                    </span>
                                                }
                                                <div class="admin-mobile-card__meta">
                                                    <span><MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" /> @agendamento.Data.ToString("dd/MM/yyyy")</span>
                                                    <span><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" /> @agendamento.Data.ToString("HH:mm")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="admin-mobile-card__side">
                                            <strong>@agendamento.Valor.ToString("C2", PtBr)</strong>
                                            <span class="@GetStatusClass(agendamento.Status)">@GetStatusText(agendamento.Status)</span>
                                        </div>

                                        <div class="admin-mobile-actions">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Success"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                                       Class="action-btn"
                                                       OnClick="@(() => OnAceitarClickedAsync(agendamento.Id))"
                                                       Disabled="@(agendamento.Status != "Pendente")">
                                                Aceitar
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.DoneAll"
                                                       Class="action-btn"
                                                       OnClick="@(() => OnConcluirClickedAsync(agendamento.Id))"
                                                       Disabled="@IsConcluido(agendamento.Status)">
                                                Concluir
                                            </MudButton>
                                            <MudTooltip Text="Excluir agendamento">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="@(() => OnDeleteClickedAsync(agendamento.Id))" />
                                            </MudTooltip>
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>

                        <div class="admin-table-footer">
                            <span>@FilteredAgendamentos.Count @ResultLabel(FilteredAgendamentos.Count)</span>
                            <div class="admin-pager">
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                               Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Disabled="@(PendingPage == 1)"
                                               OnClick="PreviousPendingPage" />
                                <span>@PendingPage / @PendingTotalPages</span>
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                               Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Disabled="@(PendingPage >= PendingTotalPages)"
                                               OnClick="NextPendingPage" />
                            </div>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Error">Acesso negado.</MudAlert>
    </NotAuthorized>
</AuthorizeView>
