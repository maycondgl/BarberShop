@page "/admin/filiais"
@using BarberShop.Core.Handlers
@using BarberShop.Core.Models
@using BarberShop.Core.Requests.Filiais
@using BarberShop.Core.Requests.HorariosFuncionamento
@attribute [Authorize(Roles = "Admin")]
@inject IFilialHandler FilialHandler
@inject IHorarioFuncionamentoHandler HorarioHandler
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>BarberShop - Gerenciar Filiais</PageTitle>

<div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-3">
    <div>
        <MudText Typo="Typo.h4" Class="font-weight-bold d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Store" Color="Color.Warning" Size="Size.Medium" />
            Gerenciar Filiais
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Cadastre novas unidades, edite endereços, consulte status e configure os horários de funcionamento abaixo.
        </MudText>
    </div>

    <MudButton Href="/admin/filiais/criar"
               Variant="Variant.Filled"
               Color="Color.Warning"
               StartIcon="@Icons.Material.Filled.Add"
               Size="Size.Large"
               Class="font-weight-bold">
        Nova Filial
    </MudButton>
</div>

<!-- Barra de Busca Rápida -->
<div class="mb-4">
    <MudTextField @bind-Value="SearchTerm"
                  Placeholder="Buscar filial por nome, endereço ou telefone..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true"
                  IconSize="Size.Medium"
                  Variant="Variant.Outlined"
                  Class="w-100" />
</div>

@if (IsBusy && !ListaFiliais.Any())
{
    <div class="d-flex justify-center my-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (!ListaFiliais.Where(Filter).Any())
{
    <MudPaper Class="pa-8 text-center my-4" Elevation="1" Style="border-radius: 12px;">
        <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
        <MudText Typo="Typo.h6">Nenhuma filial encontrada</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(string.IsNullOrWhiteSpace(SearchTerm) ? "Cadastre sua primeira filial clicando no botão acima." : "Nenhuma filial corresponde ao termo pesquisado.")
        </MudText>
    </MudPaper>
}
else
{
    <!-- Visualização Desktop -->
    <div class="d-none d-md-block">
        <MudPaper Elevation="2" Style="border-radius: 14px; overflow: hidden;">
            <MudDataGrid Items="@ListaFiliais.Where(Filter)" Hover="true" Elevation="0">
                <Columns>
                    <TemplateColumn Title="Unidade" CellClass="py-3 font-weight-bold" HeaderClass="py-3 font-weight-bold">
                        <CellTemplate Context="filial">
                            <div class="d-flex align-center gap-3">
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Storefront" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body1" Class="font-weight-bold">@filial.Item.Nome</MudText>
                                </div>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Endereço / Localização" CellClass="py-3" HeaderClass="py-3 font-weight-bold">
                        <CellTemplate Context="filial">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">@filial.Item.Localizacao</MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Telefone" CellClass="py-3" HeaderClass="py-3 font-weight-bold">
                        <CellTemplate Context="filial">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(filial.Item.Telefone) ? "Não informado" : filial.Item.Telefone)</MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Status" CellClass="py-3" HeaderClass="py-3 font-weight-bold">
                        <CellTemplate Context="filial">
                            <MudChip Size="Size.Small"
                                     Variant="Variant.Filled"
                                     Color="@(filial.Item.Ativo ? Color.Success : Color.Default)">
                                @(filial.Item.Ativo ? "Ativa" : "Inativa")
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Ações" CellClass="py-3" HeaderClass="py-3 font-weight-bold">
                        <CellTemplate Context="filial">
                            <div class="d-flex align-center gap-2">
                                <MudButton Size="Size.Small"
                                           Variant="@(FilialSelecionadaId == filial.Item.Id ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.AccessTime"
                                           OnClick="@(() => SelecionarFilialHorariosAsync(filial.Item.Id))">
                                    Horários
                                </MudButton>

                                <MudButton Href="@($"/admin/filiais/editar/{filial.Item.Id}")"
                                           Size="Size.Small"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Edit">
                                    Editar
                                </MudButton>

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Title="Excluir filial"
                                               OnClick="@(() => OnDeleteClickedAsync(filial.Item.Id))" />
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudPaper>
    </div>

    <!-- Visualização Mobile -->
    <div class="d-block d-md-none">
        <div class="admin-corte-mobile-list">
            @foreach (var filial in ListaFiliais.Where(Filter))
            {
                <div class="admin-corte-card">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <div class="d-flex align-center gap-2">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" />
                            </MudAvatar>
                            <span class="font-weight-bold" style="font-size: 1.05rem;">@filial.Nome</span>
                        </div>
                        <MudChip Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Color="@(filial.Ativo ? Color.Success : Color.Default)">
                            @(filial.Ativo ? "Ativa" : "Inativa")
                        </MudChip>
                    </div>

                    <div class="d-flex align-center gap-2 mb-2 text-secondary" style="font-size: 0.85rem;">
                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                        <span>@filial.Localizacao</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(filial.Telefone))
                    {
                        <div class="d-flex align-center gap-2 mb-3 text-secondary" style="font-size: 0.85rem;">
                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                            <span>@filial.Telefone</span>
                        </div>
                    }

                    <div class="admin-corte-card__actions mt-3">
                        <MudButton Variant="@(FilialSelecionadaId == filial.Id ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Warning"
                                   Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.AccessTime"
                                   OnClick="@(() => SelecionarFilialHorariosAsync(filial.Id))"
                                   Class="flex-1 font-weight-bold"
                                   Style="min-height: 44px; border-radius: 8px;">
                            Horários
                        </MudButton>

                        <MudButton Href="@($"/admin/filiais/editar/{filial.Id}")"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   Class="flex-1 font-weight-bold"
                                   Style="min-height: 44px; border-radius: 8px;">
                            Editar
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="@(() => OnDeleteClickedAsync(filial.Id))"
                                   Class="font-weight-bold"
                                   Style="min-height: 44px; border-radius: 8px; min-width: 100px;">
                            Excluir
                        </MudButton>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Seção Integrada: Horários de Funcionamento da Filial -->
@if (ListaFiliais.Any())
{
    <div id="secao-horarios-funcionamento" class="mt-8">
        <MudDivider Class="my-6" />

        <div class="mb-4">
            <MudText Typo="Typo.h4" Class="font-weight-bold d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Color="Color.Warning" Size="Size.Medium" />
                Horários de Funcionamento
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Configure os dias de operação, horários de abertura/fechamento e intervalos de almoço por filial. Os períodos definidos influenciarão diretamente a disponibilidade de agendamentos.
            </MudText>
        </div>

        <!-- Seletor da Filial Ativa -->
        <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius: 12px;">
            <MudGrid AlignItems="Center">
                <MudItem xs="12" md="6">
                    <MudSelect T="long?"
                               Label="Selecione a Filial"
                               Value="@FilialSelecionadaId"
                               ValueChanged="OnFilialHorarioChangedAsync"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter">
                        @foreach (var f in ListaFiliais)
                        {
                            <MudSelectItem T="long?" Value="@((long?)f.Id)">
                                @f.Nome @(f.Ativo ? "" : " (Inativa)")
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    @if (FilialSelecionada != null)
                    {
                        <div class="d-flex align-center gap-2 flex-wrap">
                            <MudChip T="string" Color="@(FilialSelecionada.Ativo ? Color.Success : Color.Error)" Size="Size.Small" Variant="Variant.Filled">
                                @(FilialSelecionada.Ativo ? "Filial Ativa" : "Filial Inativa")
                            </MudChip>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Style="vertical-align: middle;" />
                                @FilialSelecionada.Localizacao
                            </MudText>
                        </div>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (IsLoadingHorarios)
        {
            <div class="d-flex justify-center my-8">
                <MudProgressCircular Color="Color.Warning" Size="Size.Large" Indeterminate="true" />
            </div>
        }
        else if (HorariosFilial.Any())
        {
            <MudPaper Class="pa-6" Elevation="2" Style="border-radius: 14px;">
                <div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-2">
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            Grade Semanal de Horários
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Defina se a filial abre no dia, horários de atendimento e se há pausa de almoço.
                        </MudText>
                    </div>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@IsSavingHorarios"
                               OnClick="SalvarHorariosAsync"
                               Class="font-weight-bold px-6">
                        @(IsSavingHorarios ? "Salvando..." : "Salvar Alterações")
                    </MudButton>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var h in HorariosFilial)
                    {
                        <MudCard Elevation="1" Class="pa-4" Style="@(h.Aberto ? "border-left: 4px solid #FFC107;" : "border-left: 4px solid #757575; opacity: 0.85;")">
                            <MudGrid AlignItems="Center" Spacing="2">
                                <MudItem xs="12" sm="3" md="2">
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                                        @h.NomeDiaSemana
                                    </MudText>
                                    <MudSwitch @bind-Value="h.Aberto"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               Label="@(h.Aberto ? "Aberto" : "Fechado")" />
                                </MudItem>

                                @if (h.Aberto)
                                {
                                    <MudItem xs="6" sm="4" md="2">
                                        <MudTimePicker Label="Abertura"
                                                       Time="@h.HorarioAbertura"
                                                       TimeChanged="@((TimeSpan? t) => { if (t.HasValue) h.HorarioAbertura = t.Value; })"
                                                       Margin="Margin.Dense"
                                                       Variant="Variant.Outlined" />
                                    </MudItem>

                                    <MudItem xs="6" sm="4" md="2">
                                        <MudTimePicker Label="Fechamento"
                                                       Time="@h.HorarioFechamento"
                                                       TimeChanged="@((TimeSpan? t) => { if (t.HasValue) h.HorarioFechamento = t.Value; })"
                                                       Margin="Margin.Dense"
                                                       Variant="Variant.Outlined" />
                                    </MudItem>

                                    <MudItem xs="12" sm="4" md="2">
                                        <MudSwitch @bind-Value="h.TemAlmoco"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   Label="@(h.TemAlmoco ? "Com Almoço" : "Sem Almoço")" />
                                    </MudItem>

                                    @if (h.TemAlmoco)
                                    {
                                        <MudItem xs="6" sm="4" md="2">
                                            <MudTimePicker Label="Início Almoço"
                                                           Time="@h.AlmocoInicio"
                                                           TimeChanged="@((TimeSpan? t) => h.AlmocoInicio = t)"
                                                           Margin="Margin.Dense"
                                                           Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="6" sm="4" md="2">
                                            <MudTimePicker Label="Fim Almoço"
                                                           Time="@h.AlmocoFim"
                                                           TimeChanged="@((TimeSpan? t) => h.AlmocoFim = t)"
                                                           Margin="Margin.Dense"
                                                           Variant="Variant.Outlined" />
                                        </MudItem>
                                    }
                                    else
                                    {
                                        <MudItem xs="12" sm="8" md="4" Class="d-flex align-center">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Atendimento contínuo sem bloqueio de almoço.
                                            </MudText>
                                        </MudItem>
                                    }
                                }
                                else
                                {
                                    <MudItem xs="12" sm="9" md="10">
                                        <MudAlert Severity="Severity.Normal" Dense="true" Class="py-1">
                                            Filial fechada neste dia. Ninguém poderá realizar agendamentos nesta data.
                                        </MudAlert>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudCard>
                    }
                </div>

                <div class="d-flex justify-end mt-6">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@IsSavingHorarios"
                               OnClick="SalvarHorariosAsync"
                               Class="font-weight-bold px-6">
                        @(IsSavingHorarios ? "Salvando..." : "Salvar Alterações")
                    </MudButton>
                </div>
            </MudPaper>
        }
    </div>
}

@code {
    public bool IsBusy { get; set; }
    public List<Filial> ListaFiliais { get; set; } = new();
    public string SearchTerm { get; set; } = string.Empty;

    // Estado da Seção de Horários de Funcionamento
    public long? FilialSelecionadaId { get; set; }
    public Filial? FilialSelecionada => ListaFiliais.FirstOrDefault(f => f.Id == FilialSelecionadaId);
    public List<HorarioFuncionamentoDto> HorariosFilial { get; set; } = [];
    public bool IsLoadingHorarios { get; set; } = false;
    public bool IsSavingHorarios { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarFiliaisAsync();

        if (ListaFiliais.Any())
        {
            FilialSelecionadaId = ListaFiliais.First().Id;
            await CarregarHorariosAsync(FilialSelecionadaId.Value);
        }
    }

    private async Task CarregarFiliaisAsync()
    {
        IsBusy = true;
        try
        {
            var request = new GetAllFilialRequest { PageNumber = 1, PageSize = 100 };
            var result = await FilialHandler.GetAllAsync(request);
            if (result.IsSuccess)
            {
                ListaFiliais = result.Data ?? new List<Filial>();
            }
            else
            {
                Snackbar.Add(result.Message ?? "Erro ao carregar filiais", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro ao conectar ao servidor: " + ex.Message, Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    public async Task SelecionarFilialHorariosAsync(long filialId)
    {
        FilialSelecionadaId = filialId;
        await CarregarHorariosAsync(filialId);
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('secao-horarios-funcionamento')?.scrollIntoView({ behavior: 'smooth' });");
        }
        catch
        {
            // Silencioso se scroll não suportado no ambiente
        }
    }

    public async Task OnFilialHorarioChangedAsync(long? novaFilialId)
    {
        if (novaFilialId == FilialSelecionadaId) return;

        FilialSelecionadaId = novaFilialId;
        if (FilialSelecionadaId.HasValue)
        {
            await CarregarHorariosAsync(FilialSelecionadaId.Value);
        }
    }

    private async Task CarregarHorariosAsync(long filialId)
    {
        IsLoadingHorarios = true;
        try
        {
            var result = await HorarioHandler.GetByFilialAsync(filialId);
            if (result.IsSuccess && result.Data != null)
            {
                HorariosFilial = result.Data;
            }
            else
            {
                Snackbar.Add(result.Message ?? "Falha ao carregar horários da filial.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro ao buscar horários: " + ex.Message, Severity.Error);
        }
        finally
        {
            IsLoadingHorarios = false;
            StateHasChanged();
        }
    }

    public async Task SalvarHorariosAsync()
    {
        if (!FilialSelecionadaId.HasValue)
        {
            Snackbar.Add("Selecione uma filial para salvar os horários.", Severity.Warning);
            return;
        }

        foreach (var h in HorariosFilial.Where(x => x.Aberto))
        {
            if (h.HorarioFechamento <= h.HorarioAbertura)
            {
                Snackbar.Add($"No dia {h.NomeDiaSemana}, o horário de fechamento deve ser maior que o de abertura.", Severity.Warning);
                return;
            }

            if (h.TemAlmoco)
            {
                if (!h.AlmocoInicio.HasValue || !h.AlmocoFim.HasValue)
                {
                    Snackbar.Add($"No dia {h.NomeDiaSemana}, informe o início e fim do almoço.", Severity.Warning);
                    return;
                }

                if (h.AlmocoFim <= h.AlmocoInicio)
                {
                    Snackbar.Add($"No dia {h.NomeDiaSemana}, o término do almoço deve ser maior que o início.", Severity.Warning);
                    return;
                }

                if (h.AlmocoInicio < h.HorarioAbertura || h.AlmocoFim > h.HorarioFechamento)
                {
                    Snackbar.Add($"No dia {h.NomeDiaSemana}, o horário de almoço deve estar dentro do horário de funcionamento.", Severity.Warning);
                    return;
                }
            }
        }

        IsSavingHorarios = true;
        try
        {
            var request = new SalvarHorariosFilialRequest
            {
                FilialId = FilialSelecionadaId.Value,
                Horarios = HorariosFilial
            };

            var result = await HorarioHandler.SaveHorariosAsync(request);
            if (result.IsSuccess)
            {
                Snackbar.Add("Horários de funcionamento e almoço salvos com sucesso!", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message ?? "Falha ao salvar horários.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro ao salvar: " + ex.Message, Severity.Error);
        }
        finally
        {
            IsSavingHorarios = false;
            StateHasChanged();
        }
    }

    private bool Filter(Filial filial)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
            return true;

        if (filial.Nome.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
            return true;

        if (filial.Localizacao.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
            return true;

        if (!string.IsNullOrWhiteSpace(filial.Telefone) && filial.Telefone.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

    private async Task OnDeleteClickedAsync(long id)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Excluir Filial",
            "Tem certeza que deseja excluir esta filial? Os agendamentos e barbeiros vinculados a ela poderão ser afetados.",
            yesText: "Sim, Excluir",
            cancelText: "Cancelar"
        );

        if (confirm == true)
        {
            IsBusy = true;
            try
            {
                var result = await FilialHandler.DeleteAsync(id);
                if (result.IsSuccess)
                {
                    ListaFiliais.RemoveAll(x => x.Id == id);
                    if (FilialSelecionadaId == id)
                    {
                        FilialSelecionadaId = ListaFiliais.FirstOrDefault()?.Id;
                        if (FilialSelecionadaId.HasValue)
                        {
                            await CarregarHorariosAsync(FilialSelecionadaId.Value);
                        }
                        else
                        {
                            HorariosFilial.Clear();
                        }
                    }
                    Snackbar.Add("Filial excluída com sucesso!", Severity.Success);
                }
                else
                {
                    Snackbar.Add(result.Message ?? "Não foi possível excluir a filial", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add("Erro: " + ex.Message, Severity.Error);
            }
            finally
            {
                IsBusy = false;
            }
        }
    }
}
