@page "/admin/dias-fechados"
@using System.Globalization
@using BarberShop.Core.Models
@inherits DiasFechadosPage
@attribute [Authorize(Roles = "Admin")]

<MudText Typo="Typo.h4" Class="mb-2 font-weight-bold">Gerenciar Dias Fechados</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
    Cadastre feriados, folgas ou dias de manutenção para que fiquem automaticamente indisponíveis para agendamento pelos clientes.
</MudText>

<MudGrid>
    <!-- Formulário para cadastrar novo dia fechado -->
    <MudItem xs="12" md="5">
        <MudCard Elevation="3" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Color="Color.Error" Class="mr-2" />
                Bloquear Nova Data
            </MudText>

            <MudDatePicker Label="Data a ser fechada"
                           @bind-Date="_novaData"
                           IsDateDisabledFunc="@(dt => dt.Date < DateTime.Today)"
                           Required="true"
                           Class="mb-3" />

            <MudTextField Label="Motivo do fechamento (opcional)"
                          @bind-Value="_novoMotivo"
                          Placeholder="Ex: Feriado Nacional, Reforma, Folga..."
                          MaxLength="150"
                          Class="mb-4" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Lock"
                       FullWidth="true"
                       Disabled="_isBusy"
                       OnClick="CadastrarDiaFechadoAsync">
                @(_isBusy ? "Salvando..." : "Bloquear Esta Data")
            </MudButton>
        </MudCard>
    </MudItem>

    <!-- Listagem de dias fechados existentes -->
    <MudItem xs="12" md="7">
        <MudCard Elevation="3" Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.h6" Class="font-weight-bold">
                    Datas Bloqueadas (@_diasFechados.Count)
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               OnClick="CarregarDiasFechadosAsync"
                               Disabled="_isBusy"
                               Title="Atualizar lista" />
            </div>

            @if (_isLoading)
            {
                <div class="d-flex justify-center my-6">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (!_diasFechados.Any())
            {
                <MudAlert Severity="Severity.Info" Class="my-2">
                    Nenhum dia fechado cadastrado. Os agendamentos ocorrerão normalmente de Segunda a Sábado.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@_diasFechados" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Data</MudTh>
                        <MudTh>Dia da Semana</MudTh>
                        <MudTh>Motivo</MudTh>
                        <MudTh Style="text-align: right;">Ação</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Data">
                            <strong>@context.Data.ToString("dd/MM/yyyy")</strong>
                        </MudTd>
                        <MudTd DataLabel="Dia">
                            @context.Data.ToString("dddd", CultureInfo.GetCultureInfo("pt-BR"))
                        </MudTd>
                        <MudTd DataLabel="Motivo">
                            @(string.IsNullOrWhiteSpace(context.Motivo) ? "Sem motivo informado" : context.Motivo)
                        </MudTd>
                        <MudTd Style="text-align: right;">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Title="Desbloquear data"
                                           OnClick="@(() => RemoverDiaFechadoAsync(context.Id, context.Data))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudCard>
    </MudItem>
</MudGrid>
