@page "/admin/barbeiros/criar"
@using BarberShop.Core.Handlers
@using BarberShop.Core.Models
@using BarberShop.Core.Requests.Barbeiros
@using BarberShop.Core.Requests.Filiais
@using BarberShop.Core.Responses.Barbeiro
@using System.Net.Http.Json
@attribute [Authorize(Roles = "Admin")]
@inject IBarbeiroHandler BarbeiroHandler
@inject IFilialHandler FilialHandler
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory

<div class="mb-4">
    <MudText Typo="Typo.h3" Class="font-weight-bold d-flex align-center gap-2">
        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Warning" Size="Size.Medium" />
        Novo Barbeiro
    </MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        Vincule uma conta cadastrada como barbeiro informando o e-mail do profissional. O sistema reconhecerá o usuário, preencherá o nome e concederá os acessos da Área do Barbeiro.
    </MudText>
</div>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
    <strong>Como funciona:</strong> O profissional deve criar uma conta normal no sistema primeiro. Ao informar o e-mail dele abaixo, o sistema recupera seus dados e ativa as permissões de Barbeiro automaticamente.
</MudAlert>

<MudPaper Class="pa-6 mt-4" Elevation="2" Style="border-radius: 14px;">
    <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
        <DataAnnotationsValidator />

        <MudGrid Spacing="3">
            <!-- 1. CAMPO DE E-MAIL DO USUÁRIO CADASTRADO COM BUSCA AUTOMÁTICA -->
            <MudItem xs="12" md="6">
                <MudTextField Label="E-mail da Conta do Barbeiro"
                              @bind-Value="InputModel.Email"
                              For="@(() => InputModel.Email)"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Placeholder="exemplo@barbearia.com"
                              Required="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(IsSearchingUser ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.Search)"
                              AdornmentColor="Color.Warning"
                              AdornmentAriaLabel="Buscar conta cadastrada"
                              OnAdornmentClick="BuscarUsuarioAsync"
                              OnBlur="BuscarUsuarioAsync" />
            </MudItem>

            <!-- 2. NOME COMPLETO (PREENCHIDO AUTOMATICAMENTE OU PERSONALIZÁVEL) -->
            <MudItem xs="12" md="6">
                <MudTextField Label="Nome de Exibição do Barbeiro"
                              @bind-Value="InputModel.Nome"
                              For="@(() => InputModel.Nome)"
                              Variant="Variant.Outlined"
                              Placeholder="Carregado automaticamente pela conta..."
                              Required="true" />
            </MudItem>

            <!-- STATUS VISUAL DA BUSCA DE USUÁRIO -->
            @if (UsuarioEncontrado != null)
            {
                <MudItem xs="12">
                    @if (UsuarioEncontrado.JaCadastradoComoBarbeiro)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Icon="@Icons.Material.Filled.Warning">
                            Este usuário já está cadastrado como barbeiro (@UsuarioEncontrado.BarbeiroNome).
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Icon="@Icons.Material.Filled.CheckCircle">
                            Conta localizada: <strong>@UsuarioEncontrado.Nome</strong> (@UsuarioEncontrado.Email).
                            Ao cadastrar, as permissões de Barbeiro serão ativadas para este usuário de imediato.
                        </MudAlert>
                    }
                </MudItem>
            }
            else if (!string.IsNullOrWhiteSpace(ErroBuscaUsuario))
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true" Icon="@Icons.Material.Filled.PersonOff">
                        @ErroBuscaUsuario
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12" md="6">
                <MudSelect T="long?"
                           Label="Vincular à Filial / Unidade"
                           @bind-Value="InputModel.FilialId"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter"
                           Clearable="true">
                    <MudSelectItem T="long?" Value="@((long?)null)">Todas as Unidades (Geral)</MudSelectItem>
                    @foreach (var filial in ListaFiliais)
                    {
                        <MudSelectItem T="long?" Value="@((long?)filial.Id)">@filial.Nome</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSwitch @bind-Value="InputModel.Ativo"
                           Color="Color.Success"
                           Label="@(InputModel.Ativo ? "Barbeiro Ativo (disponível para agendamento)" : "Barbeiro Inativo")" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField Label="URL da Foto do Barbeiro"
                              @bind-Value="InputModel.FotoUrl"
                              For="@(() => InputModel.FotoUrl)"
                              Variant="Variant.Outlined"
                              Placeholder="https://... ou selecione um arquivo abaixo" />
            </MudItem>

            <MudItem xs="12">
                <InputFile OnChange="UploadFotoBarbeiroAsync" accept="image/*" />
            </MudItem>

            <!-- Card de Pré-visualização no Fluxo de Agendamento -->
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">Pré-visualização no Fluxo de Agendamento:</MudText>
                <div class="selector-preview-card selector-preview-card--filled" style="max-width: 500px;">
                    <div class="d-flex align-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(InputModel.FotoUrl))
                        {
                            <MudAvatar Size="Size.Medium">
                                <MudImage Src="@InputModel.FotoUrl" ObjectFit="ObjectFit.Cover" />
                            </MudAvatar>
                        }
                        else
                        {
                            <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                            </MudAvatar>
                        }
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Color="Color.Warning">
                                @(string.IsNullOrWhiteSpace(InputModel.Nome) ? "Nome do Barbeiro" : InputModel.Nome)
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(GetNomeFilial(InputModel.FilialId))
                            </MudText>
                        </div>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end gap-3 mt-4">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Href="/admin/barbeiros">
                    Voltar
                </MudButton>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Warning"
                           Disabled="@(IsBusy || (UsuarioEncontrado != null && UsuarioEncontrado.JaCadastradoComoBarbeiro))"
                           Class="font-weight-bold px-6">
                    @(IsBusy ? "Cadastrando..." : "Cadastrar Barbeiro")
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    public bool IsBusy { get; set; } = false;
    public bool IsSearchingUser { get; set; } = false;
    public CreateBarbeiroRequest InputModel { get; set; } = new();
    public List<Filial> ListaFiliais { get; set; } = new();

    public BarbeiroUsuarioInfoResponse? UsuarioEncontrado { get; set; }
    public string? ErroBuscaUsuario { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var filiaisResult = await FilialHandler.GetAllAsync(new GetAllFilialRequest { PageNumber = 1, PageSize = 100 });
            if (filiaisResult.IsSuccess)
                ListaFiliais = filiaisResult.Data ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro ao carregar filiais: " + ex.Message, Severity.Warning);
        }
    }

    private string GetNomeFilial(long? filialId)
    {
        if (!filialId.HasValue) return "Todas as Unidades (Geral)";
        var f = ListaFiliais.FirstOrDefault(x => x.Id == filialId.Value);
        return f?.Nome ?? "Unidade vinculada";
    }

    private async Task BuscarUsuarioAsync()
    {
        if (string.IsNullOrWhiteSpace(InputModel.Email) || !InputModel.Email.Contains('@'))
            return;

        IsSearchingUser = true;
        ErroBuscaUsuario = null;
        UsuarioEncontrado = null;

        try
        {
            var result = await BarbeiroHandler.BuscarUsuarioPorEmailAsync(InputModel.Email);
            if (result.IsSuccess && result.Data != null)
            {
                UsuarioEncontrado = result.Data;
                InputModel.UsuarioId = result.Data.Id;
                if (string.IsNullOrWhiteSpace(InputModel.Nome))
                {
                    InputModel.Nome = result.Data.Nome;
                }
            }
            else
            {
                ErroBuscaUsuario = result.Message ?? "Nenhum usuário cadastrado encontrado com este e-mail. Solicite que o profissional crie uma conta primeiro.";
                InputModel.UsuarioId = null;
            }
        }
        catch (Exception ex)
        {
            ErroBuscaUsuario = "Erro ao consultar usuário: " + ex.Message;
            InputModel.UsuarioId = null;
        }
        finally
        {
            IsSearchingUser = false;
            StateHasChanged();
        }
    }

    private async Task UploadFotoBarbeiroAsync(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            IsBusy = true;
            Snackbar.Add("Enviando foto...", Severity.Info);

            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(file.OpenReadStream(5_000_000));
            var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(contentType);
            content.Add(streamContent, "file", file.Name);

            var client = HttpClientFactory.CreateClient(Configuration.HttpClientName);
            var response = await client.PostAsync("v1/barbeiros/upload-imagem", content);

            if (!response.IsSuccessStatusCode)
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Erro ao enviar imagem: {errorMsg}", Severity.Error);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<UploadBarbeiroImagemResponse>();
            if (result != null && !string.IsNullOrWhiteSpace(result.ImagemUrl))
            {
                InputModel.FotoUrl = result.ImagemUrl;
                Snackbar.Add("Foto enviada com sucesso!", Severity.Success);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro ao fazer upload da imagem: " + ex.Message, Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(InputModel.Email))
        {
            Snackbar.Add("Informe o e-mail do usuário cadastrado.", Severity.Warning);
            return;
        }

        if (UsuarioEncontrado != null && UsuarioEncontrado.JaCadastradoComoBarbeiro)
        {
            Snackbar.Add("Este usuário já está cadastrado como barbeiro.", Severity.Error);
            return;
        }

        IsBusy = true;
        try
        {
            var result = await BarbeiroHandler.CreateAsync(InputModel);
            if (result.IsSuccess)
            {
                Snackbar.Add("Barbeiro cadastrado com sucesso! As permissões de acesso já foram concedidas ao usuário.", Severity.Success);
                NavigationManager.NavigateTo("/admin/barbeiros");
            }
            else
            {
                Snackbar.Add(result.Message ?? "Erro ao cadastrar barbeiro", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro: " + ex.Message, Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }
}
