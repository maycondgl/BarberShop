@page "/admin/dashboard"
@using System.Globalization
@using BarberShop.Core.Responses.Dashboard
@inherits DashboardPage
@attribute [Authorize(Roles = "Admin")]

<PageTitle>BarberShop - Dashboard Administrativo</PageTitle>

<div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-2">
    <div>
        <MudText Typo="Typo.h4" Class="font-weight-bold">Dashboard Administrativo</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Métricas de desempenho, faturamento e serviços mais procurados da barbearia.
        </MudText>
    </div>

    <div class="d-flex align-center gap-2 flex-wrap">
        <div style="min-width: 240px;">
            <MudSelect T="long?"
                       Value="@_filialSelecionadaId"
                       ValueChanged="OnFilialChangedAsync"
                       Label="Filtrar por Filial"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Dense="true"
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem T="long?" Value="@((long?)null)">
                    🏬 Todas as Filiais
                </MudSelectItem>
                @foreach (var filial in _filiais)
                {
                    <MudSelectItem T="long?" Value="@((long?)filial.Id)">
                        @filial.Nome @(filial.Ativo ? "" : " (Inativa)")
                    </MudSelectItem>
                }
            </MudSelect>
        </div>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="_isBusy"
                   OnClick="CarregarDashboardAsync">
            @(_isBusy ? "Atualizando..." : "Atualizar")
        </MudButton>
    </div>
</div>

@if (_isBusy && _dashboardData == null)
{
    <div class="d-flex justify-center my-12">
        <MudProgressCircular Color="Color.Warning" Size="Size.Large" Indeterminate="true" />
    </div>
}
else if (_dashboardData != null)
{
    <!-- 1. CARDS DE KPIS FINANCEIROS -->
    <MudGrid Class="mb-4">
        <!-- Lucro Hoje -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Class="pa-4 h-100" Style="border-left: 5px solid #FFC107;">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">LUCRO HOJE</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #FFC107;">
                            @_dashboardData.LucroDia.ToString("C", PtBr)
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @_dashboardData.TotalAgendamentosHoje atendimento(s) hoje
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.Today" />
                    </MudAvatar>
                </div>
            </MudCard>
        </MudItem>

        <!-- Lucro Semana -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Class="pa-4 h-100" Style="border-left: 5px solid #4CAF50;">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">LUCRO DESTA SEMANA</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #4CAF50;">
                            @_dashboardData.LucroSemana.ToString("C", PtBr)
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @_dashboardData.TotalAgendamentosSemana atendimento(s) na semana
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.DateRange" />
                    </MudAvatar>
                </div>
            </MudCard>
        </MudItem>

        <!-- Lucro Mês -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Class="pa-4 h-100" Style="border-left: 5px solid #2196F3;">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">LUCRO DESTE MÊS</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #2196F3;">
                            @_dashboardData.LucroMes.ToString("C", PtBr)
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @_dashboardData.TotalAgendamentosMes atendimento(s) no mês
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" />
                    </MudAvatar>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- 2. RANKINGS SIMÉTRICOS: TOP 3 CLIENTES VS TOP 3 SERVIÇOS -->
    <MudGrid Class="mb-6">
        <!-- Top 3 Clientes -->
        <MudItem xs="12" md="6" Class="d-flex">
            <MudCard Elevation="3" Class="pa-4 d-flex flex-column justify-space-between flex-grow-1" Style="border-left: 5px solid #AB47BC;">
                <div>
                    <div class="d-flex justify-space-between align-center mb-3">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">RANKING DE CLIENTES</MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">
                                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Class="mr-1" />
                                Top 3 Clientes que Mais Agendaram
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.People" />
                        </MudAvatar>
                    </div>

                    @if (_dashboardData.TopClientes.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @for (int i = 0; i < _dashboardData.TopClientes.Count; i++)
                            {
                                var cliente = _dashboardData.TopClientes[i];
                                var medalha = i switch { 0 => "🥇 1º", 1 => "🥈 2º", _ => "🥉 3º" };
                                var corBorda = i switch { 0 => "#FFD700", 1 => "#C0C0C0", _ => "#CD7F32" };

                                <div class="d-flex justify-space-between align-center pa-2 rounded"
                                     style="background: rgba(255,255,255,0.04); border-left: 3px solid @corBorda;">
                                    <div class="d-flex align-center gap-2">
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@medalha</MudText>
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold">@cliente.Nome</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Total gasto: @cliente.TotalGasto.ToString("C", PtBr)
                                            </MudText>
                                        </div>
                                    </div>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                        @cliente.TotalAgendamentos serviço(s)
                                    </MudChip>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                            Nenhum agendamento registrado ainda.
                        </MudText>
                    }
                </div>
            </MudCard>
        </MudItem>

        <!-- Top 3 Serviços do Catálogo -->
        <MudItem xs="12" md="6" Class="d-flex">
            <MudCard Elevation="3" Class="pa-4 d-flex flex-column justify-space-between flex-grow-1" Style="border-left: 5px solid #FF7043;">
                <div>
                    <div class="d-flex justify-space-between align-center mb-3">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">PREFERÊNCIA DO CATÁLOGO</MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">
                                <MudIcon Icon="@Icons.Material.Filled.ContentCut" Color="Color.Error" Class="mr-1" />
                                Top 3 Serviços Mais Escolhidos
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Error" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.ContentCut" />
                        </MudAvatar>
                    </div>

                    @{
                        var topServicos = _dashboardData.CortesMetricas
                            .Where(c => c.Quantidade > 0)
                            .OrderByDescending(c => c.Quantidade)
                            .Take(3)
                            .ToList();
                    }

                    @if (topServicos.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @for (int i = 0; i < topServicos.Count; i++)
                            {
                                var servico = topServicos[i];
                                var medalha = i switch { 0 => "🥇 1º", 1 => "🥈 2º", _ => "🥉 3º" };
                                var corBorda = i switch { 0 => "#FFD700", 1 => "#C0C0C0", _ => "#CD7F32" };

                                <div class="d-flex justify-space-between align-center pa-2 rounded"
                                     style="background: rgba(255,255,255,0.04); border-left: 3px solid @corBorda;">
                                    <div class="d-flex align-center gap-2">
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@medalha</MudText>
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold">@servico.Titulo</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Receita gerada: @servico.TotalReceita.ToString("C", PtBr)
                                            </MudText>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                                            @servico.Quantidade serviço(s) (@servico.Porcentagem.ToString("N1", PtBr)%)
                                        </MudChip>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                            Nenhum agendamento registrado ainda.
                        </MudText>
                    }
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- 3. SEÇÃO DE GRÁFICOS: ALINHAMENTO PERFEITO DE ALTURA E TEXTOS -->
    <MudGrid Class="mb-6">
        <!-- Gráfico 1: Faturamento & Lucro com Rótulos em 2 Linhas -->
        <MudItem xs="12" lg="6" Class="d-flex">
            <MudCard Elevation="3" Class="pa-4 d-flex flex-column justify-space-between flex-grow-1">
                <div>
                    <!-- Cabeçalho e Seletor -->
                    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">
                                <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Warning" Class="mr-2" />
                                Faturamento & Lucro (R$)
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @_periodoDescricao
                            </MudText>
                        </div>

                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning">
                            <MudButton Variant="@(_periodoSelecionado == PeriodoTipo.Dia ? Variant.Filled : Variant.Outlined)"
                                       OnClick="@(() => MudarPeriodo(PeriodoTipo.Dia))">
                                Dia
                            </MudButton>
                            <MudButton Variant="@(_periodoSelecionado == PeriodoTipo.Semana ? Variant.Filled : Variant.Outlined)"
                                       OnClick="@(() => MudarPeriodo(PeriodoTipo.Semana))">
                                Semana
                            </MudButton>
                            <MudButton Variant="@(_periodoSelecionado == PeriodoTipo.Mes ? Variant.Filled : Variant.Outlined)"
                                       OnClick="@(() => MudarPeriodo(PeriodoTipo.Mes))">
                                Mês
                            </MudButton>
                            <MudButton Variant="@(_periodoSelecionado == PeriodoTipo.Ano ? Variant.Filled : Variant.Outlined)"
                                       OnClick="@(() => MudarPeriodo(PeriodoTipo.Ano))">
                                Ano
                            </MudButton>
                            <MudButton Variant="@(_periodoSelecionado == PeriodoTipo.Comparativo ? Variant.Filled : Variant.Outlined)"
                                       OnClick="@(() => MudarPeriodo(PeriodoTipo.Comparativo))">
                                Comparativo
                            </MudButton>
                        </MudButtonGroup>
                    </div>

                    <!-- Barra de Navegação Temporal (< Data/Período >) -->
                    <div class="d-flex justify-space-between align-center flex-wrap gap-2 px-3 py-2 rounded mb-3"
                         style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                        <div class="d-flex align-center gap-2">
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                           Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Color="Color.Warning"
                                           Title="Anterior"
                                           OnClick="@(() => NavegarPeriodo(-1))" />

                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Color="Color.Warning" />
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                    @PeriodoFormatado
                                </MudText>
                            </div>

                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                           Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Color="Color.Warning"
                                           Title="Próximo"
                                           OnClick="@(() => NavegarPeriodo(1))" />
                        </div>

                        @if (!IsPeriodoAtual)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Size="Size.Small"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Today"
                                       OnClick="IrParaHoje">
                                Voltar para Hoje
                            </MudButton>
                        }
                    </div>

                    <!-- Gráfico SVG com Eixo X em Duas Linhas Sem Sobreposição -->
                    <div class="d-flex justify-center align-center" style="min-height: 360px; width: 100%;">
                        <svg viewBox="0 0 640 360" style="width: 100%; height: auto; min-height: 360px; overflow: visible;">
                            <defs>
                                <linearGradient id="barGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" stop-color="#2979FF" />
                                    <stop offset="100%" stop-color="#1565C0" />
                                </linearGradient>
                            </defs>

                            <!-- Linhas horizontais e rótulos do eixo Y -->
                            @foreach (var tick in _yAxisTicks)
                            {
                                <line x1="65" y1="@tick.Y.ToString(Inv)" x2="605" y2="@tick.Y.ToString(Inv)"
                                      stroke="rgba(255, 255, 255, 0.08)"
                                      stroke-dasharray="3,3" />

                                @((MarkupString)$"<text x=\"58\" y=\"{(tick.Y + 4).ToString(Inv)}\" text-anchor=\"end\" fill=\"rgba(255, 255, 255, 0.5)\" font-size=\"12\">{tick.Label}</text>")
                            }

                            <!-- Linha de base X -->
                            <line x1="65" y1="295" x2="605" y2="295" stroke="rgba(255, 255, 255, 0.25)" stroke-width="1.5" />

                            <!-- Barras e Rótulos -->
                            @foreach (var bar in _barItems)
                            {
                                @if (bar.Height > 0)
                                {
                                    <rect x="@bar.X.ToString(Inv)"
                                          y="@bar.Y.ToString(Inv)"
                                          width="@bar.Width.ToString(Inv)"
                                          height="@bar.Height.ToString(Inv)"
                                          rx="6"
                                          fill="url(#barGradient)" />

                                    @((MarkupString)$"<text x=\"{bar.CenterX.ToString(Inv)}\" y=\"{(bar.Y - 8).ToString(Inv)}\" text-anchor=\"middle\" fill=\"#FFC107\" font-size=\"12\" font-weight=\"bold\">{bar.ValorFormatado}</text>")
                                }
                                else
                                {
                                    <rect x="@bar.X.ToString(Inv)"
                                          y="293"
                                          width="@bar.Width.ToString(Inv)"
                                          height="2"
                                          rx="1"
                                          fill="rgba(255,255,255,0.2)" />

                                    @((MarkupString)$"<text x=\"{bar.CenterX.ToString(Inv)}\" y=\"286\" text-anchor=\"middle\" fill=\"rgba(255, 255, 255, 0.35)\" font-size=\"11\">R$ 0</text>")
                                }

                                <!-- Rótulo no Eixo X (Linha 1: Dia da semana ou nome) -->
                                @((MarkupString)$"<text x=\"{bar.CenterX.ToString(Inv)}\" y=\"318\" text-anchor=\"middle\" fill=\"#FFFFFF\" font-size=\"12\" font-weight=\"bold\">{bar.RotuloLinha1}</text>")

                                @if (!string.IsNullOrEmpty(bar.RotuloLinha2))
                                {
                                    <!-- Rótulo no Eixo X (Linha 2: Data em fonte suave) -->
                                    @((MarkupString)$"<text x=\"{bar.CenterX.ToString(Inv)}\" y=\"336\" text-anchor=\"middle\" fill=\"rgba(255, 255, 255, 0.6)\" font-size=\"11\">{bar.RotuloLinha2}</text>")
                                }
                            }
                        </svg>
                    </div>
                </div>

                <!-- Rodapé Informativo para Alinhamento Perfeito com o Card Vizinho -->
                <div class="d-flex justify-center align-center gap-2 mt-4 pt-2" style="border-top: 1px solid rgba(255,255,255,0.06);">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Warning" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Faturamento apurado com exclusão de agendamentos cancelados
                    </MudText>
                </div>
            </MudCard>
        </MudItem>

        <!-- Gráfico 2: Agendamentos por Serviço com Hastes e Porcentagens -->
        <MudItem xs="12" lg="6" Class="d-flex">
            <MudCard Elevation="3" Class="pa-4 d-flex flex-column justify-space-between flex-grow-1">
                <div>
                    <!-- Cabeçalho -->
                    <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="Color.Secondary" Class="mr-2" />
                        Agendamentos por Serviço
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                        Distribuição da quantidade e porcentagem (%) para cada serviço do catálogo
                    </MudText>

                    <!-- Gráfico SVG com Hastes Anti-Colisão -->
                    <div class="d-flex justify-center align-center" style="min-height: 280px; width: 100%;">
                        @if (_pieSlices.Any())
                        {
                            <div style="width: 100%; max-width: 440px;">
                                <svg viewBox="0 0 420 270" style="width: 100%; height: auto; overflow: visible;">
                                    @foreach (var slice in _pieSlices)
                                    {
                                        @if (slice.IsFullCircle)
                                        {
                                            <circle cx="210" cy="135" r="75" fill="@slice.Cor" stroke="#121212" stroke-width="2" />
                                        }
                                        else
                                        {
                                            <path d="@slice.PathData"
                                                  fill="@slice.Cor"
                                                  stroke="#121212"
                                                  stroke-width="2" />
                                        }

                                        <!-- Linha indicadora com altura ajustada -->
                                        <polyline points="@($"{slice.LineX1.ToString(Inv)},{slice.LineY1.ToString(Inv)} {slice.LineX2.ToString(Inv)},{slice.LineY2.ToString(Inv)} {slice.LineX3.ToString(Inv)},{slice.LineY3.ToString(Inv)}")"
                                                  stroke="@slice.Cor"
                                                  stroke-width="2"
                                                  fill="none" />

                                        <!-- Porcentagem em negrito branca -->
                                        @((MarkupString)$"<text x=\"{slice.TextX.ToString(Inv)}\" y=\"{slice.TextY.ToString(Inv)}\" text-anchor=\"{slice.TextAnchor}\" fill=\"#FFFFFF\" font-size=\"12\" font-weight=\"bold\">{slice.RotuloPorcentagem}</text>")
                                    }
                                </svg>
                            </div>
                        }
                        else
                        {
                            <div class="text-center pa-6">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Nenhum agendamento registrado ainda.
                                </MudText>
                            </div>
                        }
                    </div>
                </div>

                <!-- Legenda no Rodapé (Alinhada com o Rodapé do Card da Esquerda) -->
                <div class="d-flex justify-center flex-wrap gap-3 mt-4 pt-2" style="border-top: 1px solid rgba(255,255,255,0.06);">
                    @foreach (var slice in _pieSlices)
                    {
                        <div class="d-flex align-center gap-1">
                            <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background-color: @slice.Cor;"></span>
                            <MudText Typo="Typo.caption" Class="font-weight-bold">
                                @slice.Titulo (@slice.Quantidade)
                            </MudText>
                        </div>
                    }
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- 4. TABELA DE DETALHAMENTO DOS SERVIÇO DO CATÁLOGO -->
    <MudCard Elevation="3" Class="pa-4">
        <MudText Typo="Typo.h6" Class="font-weight-bold mb-3">
            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Color="Color.Primary" Class="mr-2" />
            Detalhamento Completo por Serviço do Catálogo
        </MudText>
        <!-- Visualização Desktop (Tabela Completa) -->
        <div class="d-none d-md-block">
            <MudTable Items="@_dashboardData.CortesMetricas" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Corte / Serviço</MudTh>
                    <MudTh Style="text-align: center;">Quantidade Agendada</MudTh>
                    <MudTh Style="text-align: center;">Participação (%)</MudTh>
                    <MudTh Style="text-align: right;">Receita Acumulada</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Serviço">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.ContentCut" Size="Size.Small" Color="Color.Secondary" />
                            <span class="font-weight-bold">@context.Titulo</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Quantidade" Style="text-align: center;">
                        <MudChip T="string" Color="@(context.Quantidade > 0 ? Color.Warning : Color.Default)" Size="Size.Small" Variant="Variant.Filled">
                            @context.Quantidade atendimento(s)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Porcentagem" Style="text-align: center;">
                        <span class="font-weight-bold">@context.Porcentagem.ToString("N1", PtBr)%</span>
                    </MudTd>
                    <MudTd DataLabel="Receita" Style="text-align: right;">
                        <span class="font-weight-bold">@context.TotalReceita.ToString("C", PtBr)</span>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-3 text-center" Color="Color.Secondary">
                        Nenhum serviço cadastrado no catálogo.
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </div>

        <!-- Visualização Mobile (Cards Separados por Serviço) -->
        <div class="d-block d-md-none">
            @if (!_dashboardData.CortesMetricas.Any())
            {
                <MudText Typo="Typo.body2" Class="pa-3 text-center" Color="Color.Secondary">
                    Nenhum serviço cadastrado no catálogo.
                </MudText>
            }
            else
            {
                <div class="dashboard-services-list">
                    @foreach (var item in @_dashboardData.CortesMetricas)
                    {
                        <div class="dashboard-service-card">
                            <div class="dashboard-service-card__header">
                                <div class="dashboard-service-card__title">
                                    <MudIcon Icon="@Icons.Material.Filled.ContentCut" Size="Size.Small" Color="Color.Warning" />
                                    <span>@item.Titulo</span>
                                </div>
                                <span class="dashboard-service-card__revenue">@item.TotalReceita.ToString("C", PtBr)</span>
                            </div>
                            <div class="dashboard-service-card__meta">
                                <MudChip T="string" Color="@(item.Quantidade > 0 ? Color.Warning : Color.Default)" Size="Size.Small" Variant="Variant.Filled" Style="height: 22px; font-size: 0.72rem; margin: 0;">
                                    @item.Quantidade atendimento(s)
                                </MudChip>
                                <span><strong>@item.Porcentagem.ToString("N1", PtBr)%</strong> do total</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </MudCard>

    <!-- 4.1 DESEMPENHO E LUCRO POR BARBEIRO -->
    <MudCard Elevation="3" Class="pa-4 mt-6">
        <div class="d-flex justify-space-between align-center mb-3">
            <div>
                <MudText Typo="Typo.h6" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Color="Color.Warning" Class="mr-2" />
                    Desempenho e Lucro por Barbeiro
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Volume de atendimentos, faturamento individual e participação no lucro total
                </MudText>
            </div>
            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                @_dashboardData.BarbeirosMetricas.Count barbeiro(s) ativo(s)
            </MudChip>
        </div>

        @if (!_dashboardData.BarbeirosMetricas.Any())
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-3 text-center">
                Nenhum barbeiro com atendimentos registrados até o momento.
            </MudText>
        }
        else
        {
            <MudGrid>
                @for (int i = 0; i < _dashboardData.BarbeirosMetricas.Count; i++)
                {
                    var b = _dashboardData.BarbeirosMetricas[i];
                    var medalha = i switch { 0 => "🥇 Mais Lucrativo", 1 => "🥈 2º Lugar", 2 => "🥉 3º Lugar", _ => $"#{i + 1}" };
                    var corBorda = i switch { 0 => "#FFD700", 1 => "#C0C0C0", 2 => "#CD7F32", _ => "rgba(255,255,255,0.12)" };

                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="2" Class="pa-3 h-100" Style="@($"border-top: 4px solid {corBorda}; background: rgba(255,255,255,0.03);")">
                            <div class="d-flex justify-space-between align-center mb-2">
                                <div class="d-flex align-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(b.FotoUrl))
                                    {
                                        <MudAvatar Size="Size.Medium">
                                            <MudImage Src="@b.FotoUrl" Alt="@b.Nome" />
                                        </MudAvatar>
                                    }
                                    else
                                    {
                                        <MudAvatar Color="Color.Warning" Size="Size.Medium">
                                            @b.Nome.FirstOrDefault()
                                        </MudAvatar>
                                    }
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@b.Nome</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@medalha</MudText>
                                    </div>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                                    @b.Porcentagem.ToString("N1", PtBr)% do total
                                </MudChip>
                            </div>

                            <MudDivider Class="my-2" />

                            <div class="d-flex justify-space-between align-center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Faturamento</MudText>
                                    <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #4CAF50;">
                                        @b.TotalLucro.ToString("C", PtBr)
                                    </MudText>
                                </div>
                                <div class="text-right">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Atendimentos</MudText>
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">
                                        @b.TotalAgendamentos
                                    </MudText>
                                </div>
                            </div>
                            <MudProgressLinear Color="Color.Warning" Value="@((double)b.Porcentagem)" Class="mt-2" Rounded="true" Size="Size.Small" />
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudCard>

    <!-- 5. SEÇÃO DE HISTÓRICO DE AGENDAMENTOS (MENSAL) -->
    <MudCard Elevation="3" Class="admin-panel admin-table-panel pa-0 mt-6" Style="overflow: hidden;">
        <div class="admin-table-toolbar">
            <div class="admin-table-title">
                <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Warning" Size="Size.Small" />
                <MudText Typo="Typo.h6">Histórico de Agendamentos</MudText>
            </div>

            <div class="admin-table-controls">
                <MudTextField @bind-Value="BuscaHistorico"
                              Placeholder="Buscar no histórico..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              IconSize="Size.Small"
                              Class="admin-search-field"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined" />

                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.FilterAlt"
                                   Class="admin-filter-btn">
                            @(string.IsNullOrWhiteSpace(_filtroStatusHistorico) ? "Status: Todos" : $"Status: {_filtroStatusHistorico}")
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="@(() => SetFiltroStatusHistorico(string.Empty))">Todos</MudMenuItem>
                        <MudMenuItem OnClick="@(() => SetFiltroStatusHistorico("Concluido"))">Concluídos</MudMenuItem>
                        <MudMenuItem OnClick="@(() => SetFiltroStatusHistorico("Aceito"))">Aceitos</MudMenuItem>
                        <MudMenuItem OnClick="@(() => SetFiltroStatusHistorico("Pendente"))">Pendentes</MudMenuItem>
                        <MudMenuItem OnClick="@(() => SetFiltroStatusHistorico("Cancelado"))">Cancelados</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>
        </div>

        <!-- Navegador de Mês & Indicadores Rápidos -->
        <div class="admin-history-month-bar">
            <div class="admin-history-month-nav">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                               Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Warning"
                               Title="Mês anterior"
                               OnClick="@(() => MudarMesHistorico(-1))" />

                <div class="admin-history-month-title">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Color="Color.Warning" />
                    <span>@MesHistoricoFormatado</span>
                </div>

                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                               Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Warning"
                               Title="Próximo mês"
                               OnClick="@(() => MudarMesHistorico(1))" />

                @if (!IsMesAtual)
                {
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Color="Color.Warning"
                               Class="ml-2"
                               OnClick="IrParaMesAtual">
                        Mês Atual
                    </MudButton>
                }
            </div>

            <div class="admin-history-month-stats">
                <div class="admin-history-stat-pill">
                    <span>Total no mês:</span>
                    <strong>@AgendamentosMesHistorico.Count</strong>
                </div>
                <div class="admin-history-stat-pill">
                    <span>Concluídos:</span>
                    <strong>@TotalConcluidosMesHistorico</strong>
                </div>
                <div class="admin-history-stat-pill admin-history-stat-pill--highlight">
                    <span>Faturamento:</span>
                    <strong>@TotalFaturamentoMesHistorico.ToString("C2", PtBr)</strong>
                </div>
            </div>
        </div>

        @if (_carregandoHistorico)
        {
            <div class="d-flex justify-center align-center pa-8">
                <MudProgressCircular Color="Color.Warning" Indeterminate="true" />
            </div>
        }
        else if (!AgendamentosHistoricoFiltrados.Any())
        {
            <div class="pa-8 text-center" style="opacity: 0.7;">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.body1">Nenhum agendamento encontrado para <strong>@MesHistoricoFormatado</strong>.</MudText>
            </div>
        }
        else
        {
            <!-- Visualização Desktop (Tabela Completa) -->
            <div class="d-none d-md-block">
                <div class="admin-table-scroll">
                    <table class="admin-schedule-table">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Data e Horário</th>
                                <th>Serviço</th>
                                <th>Valor</th>
                                <th>Minutos</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var agendamento in PagedHistorico)
                            {
                                <tr>
                                    <td>
                                        <div class="admin-client-cell">
                                            <span class="admin-avatar">@GetInitials(agendamento.NomeCliente)</span>
                                            <span>
                                                <strong>@agendamento.NomeCliente</strong>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="admin-date-cell">
                                            <span><MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" /> @agendamento.Data.ToString("dd/MM/yyyy")</span>
                                            <span><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" /> @agendamento.Data.ToString("HH:mm")</span>
                                        </div>
                                    </td>
                                    <td>@agendamento.CorteTitulo</td>
                                    <td>@agendamento.Valor.ToString("C2", PtBr)</td>
                                    <td>@agendamento.TempoMinutos min</td>
                                    <td>
                                        <span class="@GetStatusClass(agendamento.Status)">@GetStatusText(agendamento.Status)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Visualização Mobile (Cards Individuais) -->
            <div class="d-block d-md-none">
                <div class="admin-mobile-list" aria-label="Histórico de agendamentos">
                    @foreach (var agendamento in PagedHistorico)
                    {
                        <article class="admin-mobile-card">
                            <div class="admin-mobile-card__main">
                                <span class="admin-avatar">@GetInitials(agendamento.NomeCliente)</span>
                                <div class="admin-mobile-card__content">
                                    <strong>@agendamento.NomeCliente</strong>
                                    <span>Corte: @agendamento.CorteTitulo</span>
                                    <div class="admin-mobile-card__meta">
                                        <span><MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" /> @agendamento.Data.ToString("dd/MM/yyyy")</span>
                                        <span><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" /> @agendamento.Data.ToString("HH:mm")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="admin-mobile-card__side">
                                <strong>@agendamento.Valor.ToString("C2", PtBr)</strong>
                                <span class="@GetStatusClass(agendamento.Status)">@GetStatusText(agendamento.Status)</span>
                            </div>
                        </article>
                    }
                </div>
            </div>

            <div class="admin-table-footer">
                <span>@AgendamentosHistoricoFiltrados.Count @ResultLabel(AgendamentosHistoricoFiltrados.Count)</span>
                <div class="admin-pager">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                   Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Disabled="@(_paginaHistorico == 1)"
                                   OnClick="PreviousHistoryPage" />
                    <span>@_paginaHistorico / @TotalPaginasHistorico</span>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                   Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Disabled="@(_paginaHistorico >= TotalPaginasHistorico)"
                                   OnClick="NextHistoryPage" />
                </div>
            </div>
        }
    </MudCard>
}
