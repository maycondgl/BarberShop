@page "/admin/avaliacoes"
@using BarberShop.Core.Responses.Avaliacao
@using MudBlazor
@inherits AdminAvaliacoesPage
@attribute [Authorize(Roles = "Admin")]

<PageTitle>BarberShop - Gestão de Avaliações</PageTitle>

<div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-2">
    <div>
        <MudText Typo="Typo.h4" Class="font-weight-bold">Gestão de Avaliações</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Visualização e moderação completa de todas as avaliações registradas na barbearia.
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Warning"
               StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="IsBusy"
               OnClick="CarregarAvaliacoesAsync">
        @(IsBusy ? "Atualizando..." : "Atualizar")
    </MudButton>
</div>

<!-- CARDS RESUMO -->
<MudGrid Class="mb-6">
    <MudItem xs="12" sm="4">
        <MudCard Elevation="3" Class="pa-4" Style="border-left: 5px solid #FFC107;">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">TOTAL DE AVALIAÇÕES</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #FFC107;">
                        @Avaliacoes.Count
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Todas as unidades
                    </MudText>
                </div>
                <MudAvatar Color="Color.Warning" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.RateReview" />
                </MudAvatar>
            </div>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudCard Elevation="3" Class="pa-4" Style="border-left: 5px solid #4CAF50;">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">MÉDIA GERAL</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #4CAF50;">
                        @MediaGeral.ToString("N1") ★
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Satisfação dos clientes
                    </MudText>
                </div>
                <MudAvatar Color="Color.Success" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                </MudAvatar>
            </div>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudCard Elevation="3" Class="pa-4" Style="border-left: 5px solid #2196F3;">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">COM COMENTÁRIO</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #2196F3;">
                        @TotalComComentario
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Feedbacks textuais
                    </MudText>
                </div>
                <MudAvatar Color="Color.Info" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.Comment" />
                </MudAvatar>
            </div>
        </MudCard>
    </MudItem>
</MudGrid>

<!-- FILTROS -->
<MudCard Elevation="3" Class="pa-4 mb-6">
    <div class="d-flex justify-space-between align-center flex-wrap gap-3">
        <div class="d-flex align-center flex-wrap gap-2">
            <MudButton Variant="@(FiltroEstrelas == null ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Warning"
                       Size="Size.Small"
                       OnClick="@(() => FiltroEstrelas = null)">
                Todas
            </MudButton>
            @for (int i = 5; i >= 1; i--)
            {
                var estrela = i;
                <MudButton Variant="@(FiltroEstrelas == estrela ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Warning"
                           Size="Size.Small"
                           OnClick="@(() => FiltroEstrelas = estrela)">
                    @estrela ★
                </MudButton>
            }
        </div>

        <div style="min-width: 280px;">
            <MudTextField @bind-Value="BuscaTexto"
                          Placeholder="Buscar cliente, barbeiro, serviço..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          IconSize="Size.Small"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined" />
        </div>
    </div>
</MudCard>

@if (IsBusy)
{
    <div class="d-flex justify-center align-center my-12">
        <MudProgressCircular Color="Color.Warning" Size="Size.Large" Indeterminate="true" />
    </div>
}
else
{
    var lista = ObterAvaliacoesFiltradas();

    if (!lista.Any())
    {
        <div class="pa-8 text-center" style="opacity: 0.7;">
            <MudIcon Icon="@Icons.Material.Filled.StarBorder" Size="Size.Large" Class="mb-2" />
            <MudText Typo="Typo.body1">Nenhuma avaliação encontrada com os filtros selecionados.</MudText>
        </div>
    }
    else
    {
        <MudGrid>
            @foreach (var av in lista)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="3" Class="pa-4 h-100 d-flex flex-column justify-space-between" Style="background: rgba(255, 255, 255, 0.03);">
                        <div>
                            <div class="d-flex justify-space-between align-center mb-2">
                                <div class="d-flex align-center gap-2">
                                    <MudAvatar Color="Color.Primary" Size="Size.Small">
                                        @av.NomeCliente.FirstOrDefault()
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@av.NomeCliente</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Cliente</MudText>
                                    </div>
                                </div>
                                <MudRating ReadOnly="true" SelectedValue="@av.Estrelas" MaxValue="5" Color="Color.Warning" Size="Size.Small" />
                            </div>

                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @if (!string.IsNullOrWhiteSpace(av.BarbeiroNome))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                                        Barbeiro: @av.BarbeiroNome
                                    </MudChip>
                                }
                                @if (!string.IsNullOrWhiteSpace(av.ServicoTitulo))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                        <MudIcon Icon="@Icons.Material.Filled.ContentCut" Size="Size.Small" Class="mr-1" />
                                        @av.ServicoTitulo
                                    </MudChip>
                                }
                            </div>

                            <MudText Typo="Typo.body2" Class="my-2" Style="color: rgba(255, 255, 255, 0.9);">
                                @(string.IsNullOrWhiteSpace(av.Comentario) ? "Sem comentário textual." : av.Comentario)
                            </MudText>
                        </div>

                        <div class="mt-3 pt-2" style="border-top: 1px solid rgba(255, 255, 255, 0.06);">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Realizada em: @av.Data.ToString("dd/MM/yyyy HH:mm")
                            </MudText>
                        </div>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
}
