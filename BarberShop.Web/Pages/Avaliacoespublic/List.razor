@page "/avaliacoes"
@using BarberShop.Core.Responses.Avaliacao
@using BarberShop.Web.Pages.Avaliacoes
@using MudBlazor
@inherits ListAvaliacaoPublicPage
@attribute [Authorize]

<PageTitle>BarberShop - Minhas Avaliações</PageTitle>

<div class="d-flex justify-space-between align-center mb-6 flex-wrap gap-2">
    <div>
        <MudText Typo="Typo.h4" Class="font-weight-bold">Minhas Avaliações</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Histórico de avaliações que você enviou para os barbeiros e serviços realizados.
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Warning"
               StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="IsBusy"
               OnClick="CarregarMinhasAvaliacoesAsync">
        @(IsBusy ? "Atualizando..." : "Atualizar")
    </MudButton>
</div>

@if (IsBusy)
{
    <MudGrid>
        @for (int i = 0; i < 6; i++)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudSkeleton Height="24px" Width="60%" />
                        <MudSkeleton Height="20px" Width="40%" Class="mt-2" />
                        <MudSkeleton Height="60px" Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}
else if (!MinhasAvaliacoes.Any())
{
    <div class="pa-8 text-center" style="opacity: 0.7;">
        <MudIcon Icon="@Icons.Material.Filled.RateReview" Size="Size.Large" Class="mb-2" />
        <MudText Typo="Typo.body1">Você ainda não avaliou nenhum agendamento.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Class="mt-4" Href="/agendamentos">
            Ver Meus Agendamentos
        </MudButton>
    </div>
}
else
{
    <MudGrid>
        @foreach (var av in MinhasAvaliacoes)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="3" Class="pa-4 h-100 d-flex flex-column justify-space-between" Style="background: rgba(255, 255, 255, 0.03);">
                    <div>
                        <div class="d-flex justify-space-between align-center mb-2">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Warning" Class="mr-1" />
                                    @(string.IsNullOrWhiteSpace(av.BarbeiroNome) ? "Barbeiro da Unidade" : av.BarbeiroNome)
                                </MudText>
                            </div>
                            <MudRating ReadOnly="true"
                                       SelectedValue="@av.Estrelas"
                                       MaxValue="5"
                                       Color="Color.Warning"
                                       Size="Size.Small" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(av.ServicoTitulo))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.ContentCut" Size="Size.Small" Class="mr-1" />
                                @av.ServicoTitulo
                            </MudChip>
                        }

                        <MudText Typo="Typo.body2" Class="my-2" Style="color: rgba(255, 255, 255, 0.9);">
                            @(string.IsNullOrWhiteSpace(av.Comentario) ? "Você não deixou comentário por escrito." : av.Comentario)
                        </MudText>
                    </div>

                    <div class="mt-3 pt-2" style="border-top: 1px solid rgba(255, 255, 255, 0.06);">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Avaliado em: @av.Data.ToString("dd/MM/yyyy HH:mm")
                        </MudText>
                    </div>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}